{
  "expo": {
    "name": "LiftOff",
    "slug": "gymapp",
    "version": "1.0.0",
    "scheme": "liftoff",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hashbiz27.liftoff"
    },
    "android": {
      "package": "com.hashbiz27.liftoff",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6974a6e3-b689-4ad3-a5c8-3ac81e43f584"
      }
    }
  }
}
